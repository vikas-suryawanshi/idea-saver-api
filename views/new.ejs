<% layout("/layouts/boilerplate.ejs") %>
    <div class="new">
        <h3><b>Add your thinking</b></h3>
        <form method="post" action="/ideas" novalidate class="needs-validation">

            <input class="form-control" type="text" name="author" placeholder="enter author" required>
            <div class="invalid-feedback">Please enter your name.</div>
            <input class="form-control" type="text"
            name="title" placeholder="enter title" required>
            <div class="invalid-feedback">
                Title must be at least 3 characters.
            </div>
            <textarea class="form-control" type="text"
            name="description" placeholder="enter your idea"
            rows="7" cols="20" required></textarea>
            <div class="invalid-feedback">
                Please describe your idea properly.
            </div>
            <br/> <br/>
            <button type="submit" class="btn btn-success">Add</button>
        </form>
    </div>