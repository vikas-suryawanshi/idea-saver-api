<% layout("/layouts/boilerplate.ejs") %>

<%for(let idea of ideas){%>
    <div class="idea">
        <h3>Author: <b><%= idea.author%></b></h3>
        <p class="idea-title">Title: <b><%= idea.title%></b></p>
        <div class="description">
                <p><b>description:</b> <%= idea.description%></p>
        </div>
        <div class="button">
            <form method="get" action="/ideas/<%= idea._id%>"><button class="btn btn-primary">Show</button></form>
            <form method="get" action="/ideas/<%= idea._id%>/edit"><button class="btn btn-success">edit</button></form>
            <form method="post" action="/ideas/<%= idea._id%>?_method=delete"><button class="btn delete-btn">delete</button></form>
        </div>
    </div>
<%}%>