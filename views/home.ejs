<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1>All ideas</h1>

    <form method="get" action="/ideas/new">Create New Idea</form>
    <%for(let idea of ideas){%>
        <div class="idea">
            <h3>Author: <b><%= idea.author%></b></h3>
            <p>title: <b><%= idea.title%></b></p>
            <div class="description">
                <p>idea: <%= idea.description%></p>
            </div>
        </div>
    <%}%>
</body>
</html>