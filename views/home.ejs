<% layout("/layouts/boilerplate.ejs") %>

<%for(let idea of ideas){%>
    <a href="/ideas/<%= idea._id%>" class="idea-overlay">
        <div class="idea mb-3">
            <h3>Author: <b><%= idea.author%></b></h3>
            <p class="idea-title">Title: <b><%= idea.title%></b></p>
            <div class="description">
                    <p><b>description:</b> <%= idea.description%></p>
            </div>
            <div class="button">
                <form method="get" action="/ideas/<%= idea._id%>"><button class="btn btn-primary">Show</button></form>
                <form method="get" action="/ideas/<%= idea._id%>/edit"><button class="btn btn-dark">Edit</button></form>
                <form method="post" action="/ideas/<%= idea._id%>?_method=delete"><button class="btn btn-danger">delete</button></form>
            </div>
        </div>
    </a>    
<%}%>