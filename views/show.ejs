<% layout("/layouts/boilerplate.ejs") %>
<h2 class="section-title">Idea Overview ⭐</h2>
        <div class="idea">
            <h3>Author: <b><%= idea.author%></b></h3>
            <p class="idea-title">Title: <b><%= idea.title%></b></p>
            <div class="description">
                <p><b>description</b>: <%= idea.description%></p>
            </div>
        </div>
        <hr/>
        <div>
            <h4>Leave a Reviews</h4>
            <form>
                <div>
                    <label for="rating" class="form-label" >Rating</label>
                    <input type="range" min="1" max="5" id="rating" 
                    name="reviews[rating]" class="form-range">
                </div>
                <div>
                    <label for="comment" class="form-label" >Comment</label>
                    <textarea type="text" id="comment" 
                    name="reviews[comment]" class="form-control"></textarea>
                </div>
            </form>
        </div>