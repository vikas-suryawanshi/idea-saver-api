<% layout("/layouts/boilerplate.ejs") %>
    <div class="edit">
        <form method="post" action="/ideas/<%=idea._id%>?_method=put"
            novalidate class="needs-validation">
            <h3>Edit your info: <b><%= idea.author%></b></h3>
            <p><strong>Title:</strong> <%= idea.title%></p>
            <br/>
            <textarea type="text" class="form-control" name="description" id="description" rows="6" required><%= idea.description%></textarea>
            <br/>
            <br/>
                <button type="submit" class="btn btn-warning">Update</button>
        </form>
    </div>