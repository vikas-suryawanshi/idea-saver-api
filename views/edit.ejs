<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Info</title>
</head>
<body>
    <div class="edit">
        <form>
            <h3>Edit your info: <b><%= idea.author%></b></h3>
            <br/>
            <p>Title: <%= idea.title%></p>
            <br/>
            <textarea name="title" id="description" rows="8" cols="15"><%= idea.description%></textarea>
            <br/>
            <br/>
            <form method="post" action="/ideas/<%=idea._id%>?_method=put">
                <button>Update</button>
            </form>
        </form>
    </div>
</body>
</html>