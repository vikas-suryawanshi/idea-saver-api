<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Info</title>
</head>
<body>
    <div class="edit">
        <form>
            <h3>Edit your info: <b><%= idea.author%></b></h3>
            <br/>
            <label for="title">Title:</label>
            <textarea name="title" id="title"><%= idea.title%></textarea>
            <br/>
            <label for="description">Description:</label>
            <textarea name="title" id="description"><%= idea.description%></textarea>
        </form>
    </div>
</body>
</html>